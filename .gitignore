.apt_generated/
.apt_generated_tests/
.classpath
.factorypath
.project
.settings/
.springBeans
.sts4-cache/

# IntelliJ IDEA
.idea/
*.iws
*.iml
*.ipr
.idea_modules/

# Visual Studio Code
.vscode/
*.code-workspace
.history/

