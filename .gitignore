# Compiled class files and build artifacts
target/
build/
dist/
out/
bin/
*.class

# Log files and crash dumps
*.log
*.tmp
*.bak
*.swp
*~
hs_err_pid*
replay_pid*

# Persistent database files (H2 / local DB storage)
data/
*.db
*.mv.db
*.trace.db

# Maven wrapper exclusions (preserve wrapper JAR and properties)
!.mvn/wrapper/maven-wrapper.jar
!.mvn/wrapper/maven-wrapper.properties
pom.xml.tag
pom.xml.releaseBackup
pom.xml.versionsBackup
pom.xml.next
release.properties
dependency-reduced-pom.xml
buildNumber.properties
.mvn/timing.properties

