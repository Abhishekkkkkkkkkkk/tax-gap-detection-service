{
  "info": {
    "name": "Tax Gap Detection & Compliance Validation Service (TGD)",
    "_postman_id": "tgd-api-collection-v1",
    "description": "Comprehensive Postman collection for the Tax Gap Detection Service assessment APIs.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "basic",
    "basic": [
      {
        "key": "username",
        "value": "auditor",
        "type": "string"
      },
      {
        "key": "password",
        "value": "auditor123",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Transaction Ingestion",
      "item": [
        {
          "name": "Upload Batch (Valid Transactions)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "[\n  {\n    \"transactionId\": \"TX-SALE-1001\",\n    \"date\": \"2026-10-15\",\n    \"customerId\": \"CUST-ALPHA\",\n    \"amount\": 25000.00,\n    \"taxRate\": 0.18,\n    \"reportedTax\": 4500.00,\n    \"transactionType\": \"SALE\"\n  },\n  {\n    \"transactionId\": \"TX-SALE-1002\",\n    \"date\": \"2026-10-16\",\n    \"customerId\": \"CUST-ALPHA\",\n    \"amount\": 15000.00,\n    \"taxRate\": 0.18,\n    \"reportedTax\": 2700.50,\n    \"transactionType\": \"SALE\"\n  },\n  {\n    \"transactionId\": \"TX-REFUND-1003\",\n    \"date\": \"2026-10-17\",\n    \"customerId\": \"CUST-ALPHA\",\n    \"amount\": 5000.00,\n    \"taxRate\": 0.18,\n    \"reportedTax\": 900.00,\n    \"transactionType\": \"REFUND\",\n    \"originalTransactionId\": \"TX-SALE-1001\"\n  },\n  {\n    \"transactionId\": \"TX-SALE-2001\",\n    \"date\": \"2026-10-18\",\n    \"customerId\": \"CUST-BETA\",\n    \"amount\": 40000.00,\n    \"taxRate\": 0.12,\n    \"reportedTax\": 4800.00,\n    \"transactionType\": \"SALE\"\n  }\n]"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/transactions/batch",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "transactions", "batch"]
            }
          }
        },
